(async function CleanConsoleBot_v15() {
    // === ЦВЕТА ДЛЯ КОНСОЛИ (Более яркие) ===
    const c = {
        reset: "\x1b[0m",
        bright: "\x1b[1m",
        dim: "\x1b[2m",
        red: "\x1b[31m",
        green: "\x1b[32m",
        yellow: "\x1b[33m",
        blue: "\x1b[34m",
        magenta: "\x1b[35m",
        cyan: "\x1b[36m",
        white: "\x1b[37m",
        gray: "\x1b[90m",
        bgBlack: "\x1b[40m",
    };

    // === КАСТОМНЫЕ ФУНКЦИИ ВЫВОДА (Очень крупно и ярко) ===
    const log = {
        info: (msg) => console.log(`\n${c.blue}${c.bright}[ ИНФО ]${c.reset} ${msg}`),
        success: (msg) => console.log(`\n${c.green}${c.bright}[ ГОТОВО ]${c.reset} ${msg}`),
        warn: (msg) => console.log(`\n${c.yellow}${c.bright}[ ВНИМАНИЕ ]${c.reset} ${msg}`),
        error: (msg) => console.log(`\n${c.red}${c.bright}[ ОШИБКА ]${c.reset} ${msg}`),
        head: (msg) => console.log(`\n${c.magenta}${c.bright}━━━━━━━━━ ${msg} ━━━━━━━━━${c.reset}`),
        progress: (current, total, text) => {
            const percent = Math.round((current / total) * 100);
            const bar = `█`.repeat(Math.floor(percent / 5)) + `░`.repeat(20 - Math.floor(percent / 5));
            console.log(`   ${c.cyan}${c.bright}${text}:${c.reset} ${c.yellow}${current}${c.reset}/${c.gray}${total}${c.reset} [${c.bright}${bar}${c.reset}] ${c.green}${percent}%${c.reset}`);
        }
    };

    // === ЗАГРУЗКА (Только один раз в начале) ===
    console.log(`\n${c.bgBlack}${c.magenta}${c.bright}  black.mark.cord v15.0 (Clean Logs)  ${c.reset}`);
    console.log(`${c.gray}${c.dim}› API Spoofing Engine loaded${c.reset}\n`);

    // === API ИНЖЕКТ ===
    let wpRequire, api, FluxDispatcher, RunningGameStore, QuestsStore;

    try {
        delete window.$;
        wpRequire = webpackChunkdiscord_app.push([[Symbol()], {}, r => r]);
        webpackChunkdiscord_app.pop();

        RunningGameStore = Object.values(wpRequire.c).find(x => x?.exports?.Ay?.getRunningGames).exports.Ay;
        QuestsStore = Object.values(wpRequire.c).find(x => x?.exports?.A?.__proto__?.getQuest).exports.A;
        FluxDispatcher = Object.values(wpRequire.c).find(x => x?.exports?.h?.__proto__?.flushWaitQueue).exports.h;
        api = Object.values(wpRequire.c).find(x => x?.exports?.Bo?.get).exports.Bo;
        
        log.success("API Discord успешно подключен!");
    } catch (e) {
        log.error("Ошибка: Скрипт работает только в Desktop App.");
        return;
    }

    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    // === ЛОГИКА СПУФИНГА ===
    async function spoofVideoQuest(quest, taskName, secondsNeeded) {
        const questName = quest.config.messages.questName;
        let secondsDone = quest.userStatus?.progress?.[taskName]?.value ?? 0;

        log.info(`📹 Запуск видео: "${questName}"`);
        
        const speed = 7; 
        let completed = false;

        while (true) {
            const remaining = Math.min(speed, secondsNeeded - secondsDone);
            await sleep(remaining * 1000);

            const timestamp = secondsDone + speed;
            try {
                const res = await api.post({
                    url: `/quests/${quest.id}/video-progress`, 
                    body: {timestamp: Math.min(secondsNeeded, timestamp + Math.random())}
                });
                
                completed = res.body.completed_at != null;
                secondsDone = Math.min(secondsNeeded, timestamp);

                log.progress(Math.floor(secondsDone), secondsNeeded, `⏱️ Просмотр`);
                
                if (timestamp >= secondsNeeded) break;
            } catch (e) {
                log.warn(`Ошибка отправки, пробуем снова...`);
            }
        }

        if (!completed) {
            await api.post({url: `/quests/${quest.id}/video-progress`, body: {timestamp: secondsNeeded}});
        }
        
        log.success(`Видео "${questName}" засчитано через API!`);
        return true;
    }

    async function spoofGameQuest(quest, taskName, secondsNeeded) {
        const questName = quest.config.messages.questName;
        const taskConfig = quest.config.taskConfig ?? quest.config.taskConfigV2;
        const taskData = taskConfig.tasks[taskName];
        const applicationId = quest.config.application?.id ?? taskData.applications?.[0]?.id;

        if(!applicationId) {
            log.warn(`Нет App ID для "${questName}"`);
            return false;
        }

        log.info(`🎮 Запуск игры: "${questName}" (Спуфинг 15 минут)`);
        const pid = Math.floor(Math.random() * 30000) + 1000;

        try {
            const res = await api.get({url: `/applications/public?application_ids=${applicationId}`});
            const appData = res.body[0];
            if(!appData) return false;

            const exeName = appData.executables?.find(x => x.os === "win32")?.name?.replace(">","") ?? appData.name.replace(/[\/\\:*?"<>|]/g, "");
            const fakeGame = {
                cmdLine: `C:\\Program Files\\${appData.name}\\${exeName}`,
                exeName: exeName, exePath: `c:/program files/${appData.name.toLowerCase()}/${exeName}`,
                hidden: false, isLauncher: false, id: applicationId, name: appData.name,
                pid: pid, pidPath: [pid], processName: appData.name, start: Date.now(),
            };

            const realGames = RunningGameStore.getRunningGames();
            const realGetRunningGames = RunningGameStore.getRunningGames;
            const realGetGameForPID = RunningGameStore.getGameForPID;

            RunningGameStore.getRunningGames = () => [fakeGame];
            RunningGameStore.getGameForPID = (pid) => [fakeGame].find(x => x.pid === pid);
            FluxDispatcher.dispatch({type: "RUNNING_GAMES_CHANGE", removed: realGames, added: [fakeGame], games: [fakeGame]});

            return new Promise((resolve) => {
                let fn = (data) => {
                    let progress = quest.config.configVersion === 1 ? data.userStatus.streamProgressSeconds : Math.floor(data.userStatus.progress[taskName]?.value || 0);
                    
                    // Форматированный вывод прогресса (без спиннера, без ошибок)
                    console.log(`   ${c.cyan}[ ИГРА ]${c.reset} ${questName}: ${c.yellow}${progress}${c.reset}/${c.gray}${secondsNeeded}${c.reset}`);
                    
                    if(progress >= secondsNeeded) {
                        RunningGameStore.getRunningGames = realGetRunningGames;
                        RunningGameStore.getGameForPID = realGetGameForPID;
                        FluxDispatcher.dispatch({type: "RUNNING_GAMES_CHANGE", removed: [fakeGame], added: [], games: []});
                        FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", fn);
                        log.success(`Игра "${questName}" засчитана!`);
                        resolve(true);
                    }
                };
                FluxDispatcher.subscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", fn);
                setTimeout(() => resolve(false), 45000);
            });
        } catch (e) {
            log.error(`Ошибка спуфинга игры: ${e}`);
            return false;
        }
    }

    // === ОСНОВНОЙ ЦИКЛ ===
    async function runQuestCycle() {
        log.head("Сканирование активных квестов");
        
        const supportedTasks = ["WATCH_VIDEO", "WATCH_VIDEO_ON_MOBILE", "PLAY_ON_DESKTOP", "PLAY_ACTIVITY"];
        
        let quests = [...QuestsStore.quests.values()].filter(x => 
            x.userStatus?.enrolledAt && 
            !x.userStatus?.completedAt && 
            new Date(x.config.expiresAt).getTime() > Date.now() && 
            supportedTasks.find(y => Object.keys((x.config.taskConfig ?? x.config.taskConfigV2).tasks).includes(y))
        );

        if(quests.length === 0) {
            log.info("Нет активных квестов! Все свободны.");
            return;
        }

        let processedCount = 0;

        for (const quest of quests) {
            const questName = quest.config.messages.questName;
            const taskConfig = quest.config.taskConfig ?? quest.config.taskConfigV2;
            const taskName = supportedTasks.find(x => taskConfig.tasks[x] != null);
            const taskData = taskConfig.tasks[taskName];
            const secondsNeeded = taskData.target;

            log.head(`🕹️ Квест: ${questName}`);

            if (taskName === "WATCH_VIDEO" || taskName === "WATCH_VIDEO_ON_MOBILE") {
                await spoofVideoQuest(quest, taskName, secondsNeeded);
                processedCount++;
            } else if (taskName === "PLAY_ON_DESKTOP" || taskName === "PLAY_ACTIVITY") {
                const result = await spoofGameQuest(quest, taskName, secondsNeeded);
                if (result) processedCount++;
            } else {
                log.warn(`Не поддерживается: ${taskName}`);
            }

            await sleep(3000);
        }

        // ФИНАЛЬНЫЙ БЛОК (Огромный и яркий, чтобы было видно в конце)
        console.log(`\n${c.bright}${c.green}═══════════════════════════════════${c.reset}`);
        console.log(`${c.bright}${c.green}       ✅ ВСЕ КВЕСТЫ ОБРАБОТАНЫ!       ${c.reset}`);
        console.log(`${c.bright}${c.green}═══════════════════════════════════${c.reset}`);
        console.log(`${c.gray}  Обработано через API: ${c.yellow}${processedCount}${c.reset} ${c.gray}квестов.${c.reset}`);
        console.log(`${c.gray}  💡 Обновите страницу (F5) и нажмите Claim Reward вручную.${c.reset}\n`);
    }

    await runQuestCycle();
})();
